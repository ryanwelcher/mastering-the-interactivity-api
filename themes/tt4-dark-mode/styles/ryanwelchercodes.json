{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/theme.json",
	"version": 3,
	"title": "RyanWelcherCodes",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "light-dark(#ffffff, #2D2B55)",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "light-dark(#f5f5f5, #1f1d3d)",
					"name": "Base / Two",
					"slug": "base-2"
				},
				{
					"color": "light-dark(#2D2B55, #ffffff)",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "light-dark(#4a4a4a, #e0e0e0)",
					"name": "Contrast / Two",
					"slug": "contrast-2"
				},
				{
					"color": "light-dark(#707070, #b0b0b0)",
					"name": "Contrast / Three",
					"slug": "contrast-3"
				},
				{
					"color": "#E76F51",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#d15a3d",
					"name": "Accent / Two",
					"slug": "accent-2"
				},
				{
					"color": "#f28b6f",
					"name": "Accent / Three",
					"slug": "accent-3"
				},
				{
					"color": "#10b981",
					"name": "Accent / Four",
					"slug": "accent-4"
				},
				{
					"color": "#ef4444",
					"name": "Accent / Five",
					"slug": "accent-5"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-2)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent-2)"
					}
				}
			},
			"link": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				},
				":hover": {
					"color": {
						"text": "light-dark(#1f1d3d, #f28b6f)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"h1": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"h2": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"h3": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"h4": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"h5": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"h6": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			},
			"core/site-title": {
				"color": {
					"text": "light-dark(#2D2B55, #E76F51)"
				}
			}
		}
	}
}
